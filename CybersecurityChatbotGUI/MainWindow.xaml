<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureNet — Cybersecurity Assistant"
        Height="550" Width="700"
        MinHeight="450" MinWidth="600"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TopicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════ -->
        <!-- LEFT PANEL — Topics Menu        -->
        <!-- ═══════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#161B22"
                BorderBrush="#21262D"
                BorderThickness="0,0,1,0">
            <StackPanel>

                <!-- Logo -->
                <Border Background="#0D1117"
                        Padding="16,20"
                        BorderBrush="#21262D"
                        BorderThickness="0,0,0,1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🛡️"
                                   FontSize="32"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="SECURENET"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#00D4FF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Cybersecurity Assistant"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="#8B949E"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Topics Label -->
                <TextBlock Text="TOPICS MENU"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#8B949E"
                           Margin="16,14,0,6"/>

                <!-- Topic Buttons -->
                <Button Content="1. Passwords"
                        Tag="password"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="2. Phishing"
                        Tag="phishing"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="3. Privacy"
                        Tag="privacy"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="4. Malware"
                        Tag="malware"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="5. Scams"
                        Tag="scam"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="6. Firewall"
                        Tag="firewall"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="7. Encryption"
                        Tag="encryption"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="8. Two-Factor Auth"
                        Tag="2fa"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="9. Backups"
                        Tag="backup"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>
                <Button Content="10. VPN"
                        Tag="vpn"
                        Click="TopicButton_Click"
                        Style="{StaticResource TopicButtonStyle}"/>

            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════ -->
        <!-- MIDDLE — Chat Area              -->
        <!-- ═══════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#3FB950"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SecureNet"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#E6EDF3"/>
                    <TextBlock Text=" is online"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#3FB950"
                               VerticalAlignment="Bottom"
                               Margin="4,0,0,1"/>
                </StackPanel>
            </Border>

            <!-- Chat messages -->
            <Border Grid.Row="1" Background="#0D1117" Padding="12,8">
                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ChatPanel" Margin="0,4"/>
                </ScrollViewer>
            </Border>

            <!-- Input area -->
            <Border Grid.Row="2"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UserInput"
                             Grid.Column="0"
                             Height="42"
                             FontSize="14"
                             FontFamily="Segoe UI"
                             Foreground="White"
                             Background="#2D333B"
                             CaretBrush="White"
                             BorderBrush="#00D4FF"
                             BorderThickness="1"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             KeyDown="UserInput_KeyDown"/>

                    <Button x:Name="SendButton"
                            Grid.Column="2"
                            Content="Send ➤"
                            Height="42"
                            Width="85"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#0D1117"
                            Background="#00D4FF"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SendButton_Click"/>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3"
                    Background="#010409"
                    BorderBrush="#21262D"
                    BorderThickness="0,1,0,0"
                    Padding="12,4">
                <TextBlock x:Name="StatusBar"
                           Text="SecureNet ready. Ask me anything about cybersecurity!"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#8B949E"/>
            </Border>

        </Grid>
    </Grid>
</Window>